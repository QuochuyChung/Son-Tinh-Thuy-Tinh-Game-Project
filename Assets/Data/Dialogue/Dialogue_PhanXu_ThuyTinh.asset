--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_PhanXu_ThuyTinh
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "S\xE1ng s\u1EDBm h\xF4m sau, tr\u01B0\u1EDBc s\xE2n r\u1ED3ng th\xE0nh
      Phong Ch\xE2u, c\u1EA3 tri\u1EC1u \u0111\xECnh n\xEDn th\u1EDF. Hai ch\xE0ng
      trai \u0111\xE3 \u0111\u1EE9ng ch\u1EDD, l\u1EC5 v\u1EADt b\xE0y \u0111\u1EE7
      sau l\u01B0ng."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "H\u00F4m qua ta \u0111\u00E3 n\u00F3i: ai mang \u0111\u1EE7 s\u00EDnh l\u1EC5 \u0111\u1EBFn tr\u01B0\u1EDBc, ng\u01B0\u1EDDi \u1EA5y \u0111\u01B0\u1EE3c r\u01B0\u1EDBc M\u1ECB N\u01B0\u01A1ng."
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "Mu\u00F4n t\u00E2u b\u1EC7 h\u1EA1, th\u1EA7n l\u00E0 Th\u1EE7y Tinh. S\u00EDnh l\u1EC5 b\u1EC7 h\u1EA1 \u0111\u00F2i, th\u1EA7n \u0111\u00E3 t\u00ECm \u0111\u1EE7, xin d\u00E2ng l\u00EAn b\u1EC7 h\u1EA1."
    illustration: {fileID: 0}
  - speaker: "S\u01A1n Tinh"
    text: "Th\u1EA7n l\xE0 S\u01A1n Tinh. L\u1EC5 v\u1EADt c\u1EE7a th\u1EA7n c\u0169ng
      \u0111\xE3 b\xE0y \u0111\u1EE7 tr\u01B0\u1EDBc s\xE2n r\u1ED3ng, ch\u1EB3ng
      thi\u1EBFu m\u1ED9t m\xF3n."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "L\u1EA1 thay... Hai ng\u01B0\u1EDDi c\xF9ng \u0111\u1EBFn m\u1ED9t l\xFAc,
      l\u1EC5 v\u1EADt nh\u01B0 nhau, ch\u1EB3ng ai k\xE9m ai."
    illustration: {fileID: 0}
  - speaker: "M\u1ECB N\u01B0\u01A1ng"
    text: "Ph\u1EE5 v\u01B0\u01A1ng... con xin nghe theo l\u1EDDi cha \u0111\u1ECBnh
      \u0111o\u1EA1t."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "L\u1EDDi vua \u0111\xE3 n\xF3i ra th\xEC kh\xF4ng th\u1EC3 r\xFAt l\u1EA1i.
      Nh\u01B0ng con g\xE1i ta ch\u1EC9 c\xF3 m\u1ED9t."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "V\u1EADy h\xE3y \u0111\u1EC3 tr\u1EDDi \u0111\u1EA5t l\xE0m ch\u1EE9ng!
      Ra \u0111\xE0n t\u1EBF sau cung \u0111i\u1EC7n, hai ng\u01B0\u1EDDi \u0111\u1EA5u
      m\u1ED9t tr\u1EADn. Ai th\u1EAFng, ng\u01B0\u1EDDi \u1EA5y r\u01B0\u1EDBc M\u1ECB
      N\u01B0\u01A1ng v\u1EC1."
    illustration: {fileID: 0}
  - speaker: "S\u01A1n Tinh"
    text: "Ng\u01B0\u01A1i d\xE2ng n\u01B0\u1EDBc cao m\u1ED9t th\u01B0\u1EDBc, ta
      d\u1EF1ng n\xFAi cao m\u1ED9t tr\u01B0\u1EE3ng. \u0110\u1EEBng mong qua \u0111\u01B0\u1EE3c
      non cao!"
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "Th\u1EA7n xin tu\xE2n l\u1EC7nh. Bi\u1EC3n c\u1EA3 r\u1ED9ng l\u1EDBn,
      ch\u1EB3ng ng\u1ECDn n\xFAi n\xE0o ch\u1EB7n n\u1ED5i."
    illustration: {fileID: 0}
  - speaker: "M\u1ECB N\u01B0\u01A1ng"
    text: "Xin hai ch\xE0ng gi\u1EEF l\u1EDDi, \u0111\u1EA5u cho c\xF4ng b\u1EB1ng.
      Thi\u1EBFp s\u1EBD ch\u1EDD ng\u01B0\u1EDDi chi\u1EBFn th\u1EAFng."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "\u0110\u01B0\u1EE3c! Tr\u1EDDi \u0111\u1EA5t ch\u1EE9ng gi\xE1m. B\u1EAFt
      \u0111\u1EA7u!"
    illustration: {fileID: 0}
