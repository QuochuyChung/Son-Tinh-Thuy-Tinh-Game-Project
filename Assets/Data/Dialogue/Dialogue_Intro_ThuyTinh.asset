--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Intro_ThuyTinh
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "V\xF9ng bi\u1EC3n ph\xEDa \u0111\xF4ng. T\u1EEB b\u1EBFn c\u1EA3ng n\xE0y,
      Th\u1EE7y Tinh l\xEAn \u0111\u01B0\u1EDDng \u0111i t\xECm s\xEDnh l\u1EC5 d\xE2ng
      l\xEAn vua H\xF9ng."
    illustration: {fileID: 0}
  - speaker: 
    text: "\u1EDE m\u1ED7i ch\u1EB7ng \u0111\u01B0\u1EDDng \u0111\u1EC1u c\xF3 m\u1ED9t
      Ng\u01B0\u1EDDi Gi\u1EEF Nhi\u1EC7m V\u1EE5. H\xE3y t\u1EDBi g\u1EA7n, nh\u1EA5n
      E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\xE0 tr\u1EA3 l\u1EDDi ba c\xE2u h\u1ECFi,
      h\u1ECD s\u1EBD m\u1EDF kh\xF3a s\xEDnh l\u1EC5 k\u1EBF ti\u1EBFp cho ng\u01B0\u01A1i."
    illustration: {fileID: 0}
  - speaker: 
    text: "S\xEDnh l\u1EC5 g\u1ED3m ba linh th\xFA. Tr\u01B0\u1EDBc h\u1EBFt l\xE0
      M\u1EADp ch\xEDn v\xE2y, hung th\u1EA7n c\u1EE7a v\xF9ng \u0111\u1EA7m n\u01B0\u1EDBc
      ph\xEDa \u0111\xF4ng, sau b\u1EBFn c\u1EA3ng v\xE0 ng\u1ECDn h\u1EA3i \u0111\u0103ng."
    illustration: {fileID: 0}
  - speaker: 
    text: "Xa h\u01A1n l\xE0 S\u1EA5u ch\xEDn \u0111u\xF4i, ng\u1EF1 tr\xEAn h\xF2n
      \u0111\u1EA3o gi\u1EEFa v\u1ECBnh. Mu\u1ED1n t\u1EDBi \u0111\xF3, ph\u1EA3i
      qua b\u1ECDn ng\u01B0 t\u1EB7c ch\u1EAFn \u0111\u01B0\u1EDDng."
    illustration: {fileID: 0}
  - speaker: 
    text: "Cu\u1ED1i c\xF9ng l\xE0 R\xF9a ch\xEDn ch\xE2n, th\u1EE7 l\u0129nh c\u1EE7a
      lo\xE0i th\u1EE7y t\u1ED9c, \u1EA9n m\xECnh \u1EDF cu\u1ED1i v\u1ECBnh."
    illustration: {fileID: 0}
  - speaker: 
    text: "Ng\u1ECDn h\u1EA3i \u0111\u0103ng b\xEAn kia v\u1ECBnh \u0111\xE3 t\u1EAFt
      t\u1EEB l\xE2u, ma n\u01B0\u1EDBc l\u1EA3ng v\u1EA3ng quanh \u0111\xF3. H\xE3y
      gi\xFAp d\xE2n ch\xE0i, h\u1ECD s\u1EBD gi\xFAp l\u1EA1i ng\u01B0\u01A1i."
    illustration: {fileID: 0}
  - speaker: 
    text: "C\xF3 \u0111\u1EE7 ba linh th\xFA, h\xE3y qua c\xE1nh c\u1ED5ng \u1EDF
      cu\u1ED1i v\u1ECBnh \u0111\u1EC3 d\xE2ng l\u1EC5 l\xEAn H\xF9ng V\u01B0\u01A1ng.
      S\u01A1n Tinh c\u0169ng \u0111\xE3 l\xEAn \u0111\u01B0\u1EDDng, \u0111\u1EEBng
      ch\u1EADm ch\xE2n!"
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "M\u1ECB N\u01B0\u01A1ng s\u1EBD l\xE0 c\u1EE7a ta. \u0110i th\xF4i!"
    illustration: {fileID: 0}
