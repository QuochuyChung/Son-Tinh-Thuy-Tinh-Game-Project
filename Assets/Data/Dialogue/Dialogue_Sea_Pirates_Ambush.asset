  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Sea_Pirates_Ambush
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: "Ng\u01B0 t\u1EB7c"
    text: "D\u1EEBng l\u1EA1i! B\u1EBFn n\xE0y l\xE0 c\u1EE7a b\u1ECDn ta. T\xEAn
      \xE1o xanh kia, mu\u1ED1n qua th\xEC \u0111\u1EC3 l\u1EA1i h\u1EBFt \u0111\u1ED3
      qu\xFD."
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "B\u1EBFn n\xE0y l\xE0 c\u1EE7a d\xE2n ch\xE0i. Tr\xE1nh \u0111\u01B0\u1EDDng,
      ta ch\u1EC9 n\xF3i m\u1ED9t l\u1EA7n."
    illustration: {fileID: 0}
  - speaker: "Ng\u01B0 t\u1EB7c"
    text: "C\u1EE9ng \u0111\u1EA7u \xE0? Anh em, x\u1EED h\u1EAFn r\u1ED3i qu\u0103ng
      xu\u1ED1ng n\u01B0\u1EDBc!"
    illustration: {fileID: 0}
