  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Gift1_ThuyTinh
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "M\u1EADp ch\xEDn v\xE2y \u0111\xE3 khu\u1EA5t ph\u1EE5c! Ng\u01B0\u1EDDi
      Gi\u1EEF Nhi\u1EC7m V\u1EE5 th\u1EE9 hai \u0111ang \u0111\u1EE9ng ch\u1EDD
      \u1EDF ch\u1EB7ng k\u1EBF ti\u1EBFp, h\xE3y t\u1EDBi g\u1EB7p h\u1ECD."
    illustration: {fileID: 0}
  - speaker: 
    text: "Tr\u1EA3 l\u1EDDi \u0111\xFAng ba c\xE2u h\u1ECFi c\u1EE7a h\u1ECD, r\u1ED3i
      ra h\xF2n \u0111\u1EA3o gi\u1EEFa v\u1ECBnh t\xECm S\u1EA5u ch\xEDn \u0111u\xF4i."
    illustration: {fileID: 0}
