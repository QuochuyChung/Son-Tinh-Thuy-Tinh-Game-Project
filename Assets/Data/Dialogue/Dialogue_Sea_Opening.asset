  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Sea_Opening
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "S\u01B0\u01A1ng ph\u1EE7 k\xEDn v\xF9ng \u0111\u1EA7m. T\u1EEB xa, m\u1ED9t
      ng\u1ECDn h\u1EA3i \u0111\u0103ng t\u1EAFt l\u1ECBm \u0111\u1EE9ng l\u1EB7ng
      tr\xEAn \u0111\u1ED3i, kh\xF4ng c\xF2n tia s\xE1ng n\xE0o."
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "N\u01B0\u1EDBc \u0111ang d\u1EADy kh\xE1c th\u01B0\u1EDDng. H\xE3y theo
      \u0111\u01B0\u1EDDng \u0111\u1EAFp t\u1EDBi B\u1EBFn Thuy\u1EC1n, h\u1ECFi
      th\u0103m ng\u01B0\u1EDDi d\xE2n ch\xE0i."
    illustration: {fileID: 0}
