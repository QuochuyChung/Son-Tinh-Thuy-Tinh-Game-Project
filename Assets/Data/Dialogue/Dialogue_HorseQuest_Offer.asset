  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_HorseQuest_Offer
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: "Ng\u01B0\u1EDDi ch\u0103n ng\u1EF1a"
    text: "Ch\xE0o ch\xE0ng trai! D\xE1ng \u0111i v\u1EEFng nh\u01B0 n\xFAi th\u1EBF
      kia, ch\u1EAFc ch\xE0ng l\xE0 S\u01A1n Tinh, ch\xFAa v\xF9ng non cao ph\u1EA3i
      kh\xF4ng?"
    illustration: {fileID: 0}
  - speaker: "S\u01A1n Tinh"
    text: "\u0110\xFAng v\u1EADy. Ta \u0111ang t\xECm ng\u1EF1a ch\xEDn h\u1ED3ng
      mao \u0111\u1EC3 d\xE2ng vua H\xF9ng l\xE0m s\xEDnh l\u1EC5, c\u1EA7u h\xF4n
      M\u1ECB N\u01B0\u01A1ng."
    illustration: {fileID: 0}
  - speaker: "Ng\u01B0\u1EDDi ch\u0103n ng\u1EF1a"
    text: "Th\u1EBF th\xEC ch\xE0ng \u0111\u1EBFn \u0111\xFAng l\xFAc, m\xE0 c\u0169ng
      \u0111\u1EBFn ch\u1EADm m\u1EA5t r\u1ED3i! \u0110\xEAm qua s\u1EA5m n\u1ED5
      r\u1EA5t l\u1EDBn, con ng\u1EF1a ch\xEDn h\u1ED3ng mao nh\xE0 t\xF4i ho\u1EA3ng
      s\u1EE3, \u0111\u1EE9t d\xE2y c\u01B0\u01A1ng ch\u1EA1y tho\xE1t l\xEAn n\xFAi."
    illustration: {fileID: 0}
  - speaker: "Ng\u01B0\u1EDDi ch\u0103n ng\u1EF1a"
    text: "T\u1EC7 h\u01A1n n\u1EEFa, t\xF4i th\u1EA5y m\u1ED9t b\u1ECDn tr\u1ED9m
      ng\u1EF1a \xE1o \u0111en c\u0169ng l\u1EA7n theo v\u1EBFt ch\xE2n n\xF3. Ch\xFAng
      m\xE0 b\u1EAFt \u0111\u01B0\u1EE3c th\xEC t\xF4i ch\u1EB3ng c\xF2n g\xEC \u0111\u1EC3
      n\xF3i."
    illustration: {fileID: 0}
  - speaker: "Ng\u01B0\u1EDDi ch\u0103n ng\u1EF1a"
    text: "\u0110\xE2y l\xE0 chi\u1EBFc chu\xF4ng \u0111\u1ED3ng \xF4ng n\u1ED9i
      t\xF4i \u0111\u1EC3 l\u1EA1i. N\xF3 nghe ti\u1EBFng chu\xF4ng n\xE0y t\u1EEB
      thu\u1EDF b\xE9, ch\u1EC9 c\u1EA7n rung l\xEAn l\xE0 n\xF3 b\xECnh t\u0129nh
      ngay. Ch\xE0ng \u0111u\u1ED5i theo gi\xFAp t\xF4i nh\xE9!"
    illustration: {fileID: 0}
  - speaker: "S\u01A1n Tinh"
    text: "\xD4ng y\xEAn t\xE2m. Ta s\u1EBD \u0111\u01B0a n\xF3 v\u1EC1."
    illustration: {fileID: 0}
  - speaker: 
    text: "Nhi\u1EC7m v\u1EE5: \u0111u\u1ED5i theo ng\u1EF1a ch\xEDn h\u1ED3ng mao
      l\xEAn \u0111\u01B0\u1EDDng n\xFAi sau l\xE0ng. V\u01B0\u1EE3t b\u1EADc \u0111\xE1,
      b\u1EADc thang v\xE0 v\u1EF1c g\xE3y, \u0111\xE1nh b\u1ECDn tr\u1ED9m ng\u1EF1a
      \u1EDF b\xE3i \u0111\xE1 r\u1ED3i l\xEAn \u0111\u1EC9nh g\xF2 rung chu\xF4ng.
      C\xF3 c\u1ED9t s\xE1ng ch\u1EC9 ch\u1ED7 con ng\u1EF1a. \u0110\u1EEBng ch\u1EA1y
      nhanh khi l\u1EA1i g\u1EA7n n\xF3."
    illustration: {fileID: 0}
