--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Ending_SonTinh
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "Tr\u1EADn chi\u1EBFn tr\xEAn ph\xE1p \u0111\xE0n \u0111\xE3 k\u1EBFt th\xFAc.
      Th\u1EE7y Tinh c\xFAi \u0111\u1EA7u, S\u01A1n Tinh v\u1EABn \u0111\u1EE9ng
      th\u1EB3ng tr\u01B0\u1EDBc \u0111i\u1EC7n."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "Tr\u1EADn \u0111\u1EA5u \u0111\xE3 ph\xE2n \u0111\u1ECBnh. S\u01A1n Tinh
      l\xE0 ng\u01B0\u1EDDi th\u1EAFng. Tr\u1EDDi \u0111\u1EA5t ch\u1EE9ng gi\xE1m,
      l\u1EDDi ta kh\xF4ng r\xFAt l\u1EA1i."
    illustration: {fileID: 0}
  - speaker: "S\u01A1n Tinh"
    text: "Th\u1EA7n xin tu\xE2n l\u1EC7nh b\u1EC7 h\u1EA1. N\xFAi T\u1EA3n Vi\xEAn
      s\u1EBD l\xE0 n\u01A1i th\u1EA7n che ch\u1EDF cho M\u1ECB N\u01B0\u01A1ng su\u1ED1t
      \u0111\u1EDDi."
    illustration: {fileID: 0}
  - speaker: "Th\u1EE7y Tinh"
    text: "Th\u1EA7n xin ch\u1ECBu thua. N\u01B0\u1EDBc d\xE2ng r\u1ED3i c\u0169ng
      r\xFAt, th\u1EA7n kh\xF4ng o\xE1n tr\xE1ch, xin lui v\u1EC1 lo vi\u1EC7c c\u1EE7a
      m\xECnh."
    illustration: {fileID: 0}
  - speaker: "M\u1ECB N\u01B0\u01A1ng"
    text: "Ch\xE0ng... thi\u1EBFp xin c\u1EA3m \u01A1n ch\xE0ng. Mong r\u1EB1ng t\u1EEB
      nay n\xFAi s\xF4ng h\xF2a b\xECnh, mu\xF4n d\xE2n y\xEAn vui."
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "Hay l\u1EAFm! C\xE1c con \u0111\xE3 v\xEC mu\xF4n d\xE2n m\xE0 giao \u0111\u1EA5u.
      H\xF4m nay m\u1EDF ti\u1EC7c m\u1EEBng, c\u1EA3 n\u01B0\u1EDBc c\xF9ng vui!"
    illustration: {fileID: 0}
  - speaker: "H\xF9ng V\u01B0\u01A1ng"
    text: "T\u1EEB nay, n\xFAi s\xF4ng l\xE0 m\u1ED9t. Hai con h\xE3y c\xF9ng nhau
      g\xECn gi\u1EEF b\u1EDD c\xF5i."
    illustration: {fileID: 0}
  - speaker: 
    text: "V\u1EADy l\xE0 t\u1EEB nay, S\u01A1n Tinh c\xF9ng M\u1ECB N\u01B0\u01A1ng
      s\u1ED1ng h\u1EA1nh ph\xFAc. N\xFAi s\xF4ng y\xEAn vui, mu\xF4n d\xE2n \u1EA5m
      no."
    illustration: {fileID: 0}
