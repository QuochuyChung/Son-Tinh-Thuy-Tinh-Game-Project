  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_FinalBattle_Intro
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "Thung l\u0169ng cu\u1ED1i c\xF9ng, n\u01A1i n\xFAi v\xE0 bi\u1EC3n gi\xE1p
      nhau. Tr\u1EADn \u0111\u1EA5u n\xE0y s\u1EBD quy\u1EBFt \u0111\u1ECBnh ai \u0111\u01B0\u1EE3c
      c\u01B0\u1EDBi M\u1ECB N\u01B0\u01A1ng."
    illustration: {fileID: 0}
  - speaker: 
    text: "B\xEAn tr\xE1i, t\u01B0\u1EE3ng S\u01A1n Tinh b\u1EB1ng \u0111\xE1, ch\xFAa
      t\u1EC3 c\u1EE7a non cao."
    illustration: {fileID: 0}
  - speaker: 
    text: "B\xEAn ph\u1EA3i, t\u01B0\u1EE3ng Th\u1EE7y Tinh ph\u1EE7 l\xF4ng v\u0169,
      ch\xFAa t\u1EC3 c\u1EE7a bi\u1EC3n c\u1EA3."
    illustration: {fileID: 0}
  - speaker: 
    text: "K\u1EBB \u0111\u1EE9ng tr\u01B0\u1EDBc m\u1EB7t ng\u01B0\u01A1i l\xE0
      \u0111\u1ED1i th\u1EE7. D\xF9ng ph\xEDm J \u0111\u1EC3 \u0111\xE1nh th\u01B0\u1EDDng,
      chu\u1ED9t ph\u1EA3i \u0111\u1EC3 \u0111\xE1nh m\u1EA1nh, v\xE0 ba chi\xEAu
      th\u1EE9c U, I, O \u0111\u1EC3 \xE1p \u0111\u1EA3o h\u1EAFn."
    illustration: {fileID: 0}
  - speaker: 
    text: "Khi thanh m\xE1u c\u1EE7a h\u1EAFn c\xF2n m\u1ED9t n\u1EEDa, h\u1EAFn
      s\u1EBD cu\u1ED3ng n\u1ED9. H\xE3y c\u1EA9n th\u1EADn. Chi\u1EBFn \u0111\u1EA5u
      th\xF4i!"
    illustration: {fileID: 0}
