  m_Script: {fileID: 11500000, guid: d9f060c80f7fac4489c5efa5acdfa9b5, type: 3}
  m_Name: Dialogue_Gift2_ThuyTinh
  m_EditorClassIdentifier: Assembly-CSharp::SonTinhThuyTinh.Dialogue.DialogueSequence
  lines:
  - speaker: 
    text: "S\u1EA5u ch\xEDn \u0111u\xF4i \u0111\xE3 quy ph\u1EE5c! Ng\u01B0\u1EDDi
      Gi\u1EEF Nhi\u1EC7m V\u1EE5 cu\u1ED1i c\xF9ng \u0111ang ch\u1EDD ph\xEDa tr\u01B0\u1EDBc,
      h\xE3y t\u1EDBi n\xF3i chuy\u1EC7n v\u1EDBi h\u1ECD."
    illustration: {fileID: 0}
  - speaker: 
    text: "V\u01B0\u1EE3t qua ba c\xE2u h\u1ECFi, r\u1ED3i xu\u1ED1ng cu\u1ED1i v\u1ECBnh
      thu ph\u1EE5c R\xF9a ch\xEDn ch\xE2n."
    illustration: {fileID: 0}
