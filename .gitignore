# This .gitignore file should be placed at the root of your Unity project directory
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Generated solution file (new Visual Studio .slnx format) and Python bytecode from tools/
*.slnx
__pycache__/
*.pyc

# Unity Asset Store packages: the license does not allow redistributing them in a public repo (and they are big).
# Each teammate downloads their own copy from the Asset Store (My Assets) into the same folder.
/Assets/TriForge Assets/
/Assets/TriForge Assets.meta
/Assets/Houidisoft technology/
/Assets/Houidisoft technology.meta
/Assets/WaterWorks/
/Assets/WaterWorks.meta
/Assets/Idyllic Fantasy Nature/
/Assets/Idyllic Fantasy Nature.meta
/Assets/Fantasy Forest Environment Free Sample/
/Assets/Fantasy Forest Environment Free Sample.meta

# Meshy downloads come as zips next to their unzipped copy: keep only the unzipped files (docs/progress.md 9.5)
/ArtSource/Meshy/*.zip
